# Пример конфигурации nginx для читалки на VPS.
# Положить в /etc/nginx/sites-available/rss-reader и включить:
#   ln -s /etc/nginx/sites-available/rss-reader /etc/nginx/sites-enabled/
#   nginx -t && systemctl reload nginx
#
# Пароль проверяет само приложение (учётные записи заводятся в админке /admin),
# поэтому дополнительный auth_basic здесь не нужен. Если хотите закрыть сервер
# ещё и на уровне nginx — раскомментируйте auth_basic ниже.

server {
    listen 80;
    listen [::]:80;
    server_name rss.example.com;

    # Для TLS используйте certbot: sudo certbot --nginx -d rss.example.com
    # и он сам добавит listen 443 ssl и редирект.

    client_max_body_size 16m;   # с запасом для импорта OPML
    access_log /var/log/nginx/rss-reader.access.log;

    # auth_basic "RSS reader";
    # auth_basic_user_file /etc/nginx/.htpasswd;

    # Живые события (SSE): буферизация их ломает, а обычный таймаут чтения
    # обрывает поток каждые 60 секунд — клиент переподключается и «мигает».
    location = /api/events {
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection '';
        proxy_buffering off;
        proxy_cache off;
        chunked_transfer_encoding off;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
        add_header X-Accel-Buffering no;
    }

    location / {
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Долгие запросы: сервер сам ходит в интернет за лентами и статьями.
        proxy_connect_timeout 30s;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        proxy_buffering off;
    }
}
